	"authors": [
		"Obqy"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/music-toggle/icon.png",
	"environment": "client",
	"entrypoints": {
      "client": [
          "com.obqy.MusicToggle"
      ]
    },
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}